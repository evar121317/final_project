% Flight Duration & Battery Depletion Simulation
clear; clc; close all;

%% 1. Parameters
total_energy = 5000;        % Watt-hours (Wh)
battery_reserve = 0.15;     % 15% safety margin (cannot fly below this)
min_energy = total_energy * battery_reserve;

% Power Consumption by Flight Mode (Watts)
power_ascent = 1200;        % High power to gain altitude
power_hover  = 800;         % High power to maintain lift without airspeed
power_cruise = 500;         % Efficient power (lift generated by wings)

dt = 1/60;                  % Time step (1 minute in hours)

%% 2. Flight Plan Definition (Duration in minutes)
% total flight: 5m ascent, 15m cruise, then hover until battery depletion
phases = [repmat(power_ascent, 1, 5), ...
          repmat(power_cruise, 1, 15)];

%% 3. Simulation Loop
energy_history = total_energy;
time_history = 0;
current_energy = total_energy;
t = 0;

% Run until battery hits reserve limit
while current_energy > min_energy
    t = t + 1;
    
    % Determine current power draw
    if t <= length(phases)
        p_draw = phases(t);
    else
        p_draw = power_hover; % Hover after mission phases are done
    end
    
    % Energy depletion: E_new = E_old - (Power * time)
    % Since dt is in hours, Energy is in Wh
    current_energy = current_energy - (p_draw * dt);
    
    % Record data
    energy_history(end+1) = current_energy;
    time_history(end+1) = t;
end

%% 4. Visualization
figure('Color', 'w');
plot(time_history, energy_history, 'LineWidth', 2);
hold on;
yline(min_energy, '--r', 'Reserve Limit');
grid on;

% Labeling the phases
text(2, total_energy-200, 'Ascent', 'FontSize', 8);
text(10, total_energy-800, 'Cruise', 'FontSize', 8);
text(time_history(end)-10, min_energy+400, 'Hover', 'FontSize', 8);

title(['Flight Duration Estimate: ', num2str(time_history(end)), ' Minutes']);
xlabel('Time (minutes)');
ylabel('Battery Energy (Wh)');
legend('Available Energy', 'Safety Reserve');
